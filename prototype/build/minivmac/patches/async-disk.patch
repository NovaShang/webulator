+/*
+	Whether a transfer can run without waiting for its data. A disk that
+	fetches lazily starts the fetch and says no; Sony_Prime then reports
+	busy and the driver retries, so the guest keeps running meanwhile.
+*/
+GLOBALOSGLUFUNC blnr vSonyReady(tDrive Drive_No, ui5r Sony_Start,
+	ui5r Sony_Count)
+{
+	return EM_ASM_INT({
+		return workerApi.disks.ready ? workerApi.disks.ready($0, $1, $2) : 1;
+	}, Drives[Drive_No], Sony_Start, Sony_Count) != 0;
+}
+
 GLOBALOSGLUFUNC tMacErr vSonyTransfer(blnr IsWrite, ui3p Buffer,
 	tDrive Drive_No, ui5r Sony_Start, ui5r Sony_Count,
 	ui5r *Sony_ActCount)
