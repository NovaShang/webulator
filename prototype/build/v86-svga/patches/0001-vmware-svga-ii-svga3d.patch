+    TEMP: 0, INPUT: 1, CONST: 2, ADDR: 3, TEXTURE: 3, RASTOUT: 4, ATTROUT: 5, OUTPUT: 6, CONSTINT: 7, COLOROUT: 8,
+    DEPTHOUT: 9, SAMPLER: 10, CONST2: 11, CONST3: 12, CONST4: 13, CONSTBOOL: 14, LOOP: 15, TEMPFLOAT16: 16,
+    MISCTYPE: 17, LABEL: 18, PREDICATE: 19,
