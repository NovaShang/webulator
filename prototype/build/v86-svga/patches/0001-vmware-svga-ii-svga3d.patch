+/** Read len bytes at offset in a GMR (or VRAM); returns a copy. */
+VMwareSVGA.prototype.guest_read = function(gmr, offset, len)
+{
+    const out = new Uint8Array(len);
+    if(gmr === GMR_LINEAR) { this.linear_read(offset, len, out, 0); return out; }
+    if(gmr === GMR_FRAMEBUFFER) { out.set(this.vga.svga_memory.subarray(offset, offset + len)); return out; }
