+                    v32[i] = v & 0xFF00FF00 | (v & 0xFF) << 16 | (v >>> 16) & 0xFF;
+                }
+            continue;
+        }
+        const rgba = this.read_rgba(s, 0, sx, sy, bw, bh);
+        this.from_rgba(bpp === 16 ? 16 : 32, rgba, vram, y * pitch + x * bytes, pitch, bw, bh);
+    }
+};
+
+SVGA3D.prototype.blit_to_screen = function(w)
+{
+    // {srcImage sid,face,mip; srcRect l,t,r,b; destScreenId; destRect l,t,r,b} + clip rects
+    const sid = w[0], sl = w[3], st = w[4], dl = w[8], dt = w[9], dr = w[10], db = w[11];
+    this.present(sid, [dl, dt, dr - dl, db - dt, sl, st], 0);
+};
+
+SVGA3D.prototype.query_result = function(w)
+{
+    // {cid, type, guestResult {gmrId, offset}}: report "succeeded, 1 sample".
+    this.svga.guest_write(w[2], w[3], new Uint8Array(new Uint32Array([12, 2, 1]).buffer));
+};
