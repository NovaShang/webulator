+
+VMwareSVGA.prototype.pitch_pixels = function()
+{
+    return this.bytes_per_line() / ((this.bpp + 7) >> 3);
+};
+
+// Show the SVGA framebuffer through the VGA device's SVGA path while enabled; hand back to VGA when disabled.
+VMwareSVGA.prototype.update_mode = function()
+{
+    const vga = this.vga;
+    if(this.enable)
