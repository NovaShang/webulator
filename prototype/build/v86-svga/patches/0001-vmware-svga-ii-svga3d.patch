+// ---------- guest linear memory (API forwarding) ----------
+
+/** Copy len bytes from guest linear address addr into out (at out_offset). Returns false on an unmapped page and
+ * records it in this.hc_fault. */
+VMwareSVGA.prototype.linear_read = function(addr, len, out, out_offset)
+{
+    const cpu = this.cpu, mem = cpu.mem8;
+    const raw = new Uint8Array(mem.buffer, mem.byteOffset, mem.length);
+    for(let done = 0; done < len;)
+    {
+        const at = addr + done >>> 0, n = Math.min(4096 - (at & 4095), len - done);
+        const phys = cpu.translate_address_peek(at | 0, false);
+        if(phys < 0 || phys + n > raw.length) { this.hc_fault = at; return false; }
+        out.set(raw.subarray(phys, phys + n), out_offset + done);
+        done += n;
+    }
+    return true;
+};
+
+VMwareSVGA.prototype.linear_write = function(addr, data)
+{
+    const cpu = this.cpu, mem = cpu.mem8;
+    const raw = new Uint8Array(mem.buffer, mem.byteOffset, mem.length);
+    for(let done = 0; done < data.length;)
+    {
+        const at = addr + done >>> 0, n = Math.min(4096 - (at & 4095), data.length - done);
+        const phys = cpu.translate_address_peek(at | 0, true);
+        if(phys < 0 || phys + n > raw.length) { this.hc_fault = at; return false; }
+        raw.set(data.subarray(done, done + n), phys);
+        cpu.jit_dirty_cache(phys, phys + n);
+        done += n;
+    }
+    return true;
