+    if(index >= PALETTE_BASE && index < PALETTE_BASE + 768) return this.palette[index - PALETTE_BASE];
+    dbg_log("vmware svga: read of unknown register " + index, LOG_VGA);
+    return 0;
+};
+
+VMwareSVGA.prototype.write_reg = function(index, value)
+{
+    if(this.reg_log.length < 4000) this.reg_log.push("w" + index + "=" + value);
+    switch(index)
+    {
+        case REG.ID:
+            this.id = value >= SVGA_ID_0 && value <= SVGA_ID_2 ? value : SVGA_ID_2;
+            return;
+        case REG.ENABLE:
+            this.enable = value & 1;
+            this.update_mode();
+            return;
+        case REG.WIDTH:
+            this.width = Math.max(1, Math.min(value, MAX_WIDTH));
+            this.update_mode();
+            return;
+        case REG.HEIGHT:
+            this.height = Math.max(1, Math.min(value, MAX_HEIGHT));
+            this.update_mode();
+            return;
+        case REG.BITS_PER_PIXEL:
+            if(value === 8 || value === 15 || value === 16 || value === 24 || value === 32) this.bpp = value;
+            this.update_mode();
+            return;
+        case REG.CONFIG_DONE:
+            this.config_done = value & 1;
