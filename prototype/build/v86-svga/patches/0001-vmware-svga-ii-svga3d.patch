+
+VMwareSVGA.prototype.fifo = function()
+{
+    const buf = this.cpu.wasm_memory.buffer;
+    if(!this.fifo_view || this.fifo_view.buffer !== buf)
+    {
+        this.fifo_view = new Uint32Array(buf, this.vga.svga_memory.byteOffset + this.fifo_offset, this.fifo_size / 4);
+    }
+    return this.fifo_view;
+};
+
+
+VMwareSVGA.prototype.init_fifo_registers = function()
+{
+    const f = this.fifo();
+    f[FIFO.CAPABILITIES] = this.fifo_capabilities;
+    f[FIFO.FLAGS] = 0;
+    f[FIFO.HWVERSION_3D] = this.hw_version_3d;
+    f[FIFO.HWVERSION_3D_REVISED] = this.hw_version_3d;
+    f[FIFO.BUSY] = 0;
+    // 3D caps: one DEVCAPS record of {index, value} pairs, then an empty record.
+    let o = FIFO.CAPS_3D;
+    f[o++] = 2 + DEVCAPS.length * 2; f[o++] = CAPS_RECORD_DEVCAPS;
+    for(const [i, v] of DEVCAPS) { f[o++] = i; f[o++] = v >>> 0; }
+    f[o++] = 0; f[o++] = 0;
+};
+
+// The XP driver lays rows out at the maximum width (it never reads BYTES_PER_LINE), so the pitch is fixed.
+VMwareSVGA.prototype.bytes_per_line = function()
+{
+    return MAX_WIDTH * 4;              // fixed in bytes ("pitchlock"), whatever the depth
+};
+
+VMwareSVGA.prototype.read_reg = function(index)
+{
+    if(this.reg_log.length < 4000 && index !== REG.BUSY) this.reg_log.push("r" + index);
+    switch(index)
+    {
+        case REG.ID: return this.id;
+        case REG.ENABLE: return this.enable;
+        case REG.WIDTH: return this.width;
+        case REG.HEIGHT: return this.height;
+        case REG.MAX_WIDTH: return MAX_WIDTH;
+        case REG.MAX_HEIGHT: return MAX_HEIGHT;
+        case REG.DEPTH: return this.bpp === 32 ? 24 : this.bpp;
+        case REG.BITS_PER_PIXEL: return this.bpp;
+        case REG.HOST_BITS_PER_PIXEL: return 32;
+        case REG.PSEUDOCOLOR: return this.bpp === 8 ? 1 : 0;
+        case REG.RED_MASK: return this.bpp === 16 ? 0xF800 : this.bpp === 15 ? 0x7C00 : 0xFF0000;
+        case REG.GREEN_MASK: return this.bpp === 16 ? 0x07E0 : this.bpp === 15 ? 0x03E0 : 0x00FF00;
+        case REG.BLUE_MASK: return this.bpp === 16 || this.bpp === 15 ? 0x001F : 0x0000FF;
+        case REG.BYTES_PER_LINE: return this.bytes_per_line();
+        case REG.FB_START: return this.lfb_address;
+        case REG.FB_OFFSET: return 0;
+        case REG.VRAM_SIZE: return this.vram_size;
+        case REG.FB_SIZE: return this.bytes_per_line() * this.height;
+        case REG.CAPABILITIES: return this.capabilities;
+        case REG.MEM_START: return this.fifo_address;
+        case REG.MEM_SIZE: return this.fifo_size;
+        case REG.CONFIG_DONE: return this.config_done;
+        case REG.SYNC: return 0;
+        case REG.BUSY: this.process_fifo(); return 0;
+        case REG.GUEST_ID: return this.guest_id;
+        case REG.SCRATCH_SIZE: return SCRATCH_SIZE;
+        case REG.MEM_REGS: return FIFO.NUM_REGS;
+        case REG.NUM_DISPLAYS: return 1;
+        case REG.PITCHLOCK: return 0;
+        case REG.IRQMASK: return 0;
+        case REG.NUM_GUEST_DISPLAYS: return 1;
+        case 47: return 256 * 1024 * 1024;                      // SVGA_REG_MEMORY_SIZE: host memory for surfaces
+        case 41: return this.gmr_id;                            // GMR_ID
+        case 43: return GMR_MAX_IDS;                            // GMR_MAX_IDS
+        case 44: return 4096;                                   // GMR_MAX_DESCRIPTOR_LENGTH
+        case 46: return GMR_MAX_PAGES;                          // GMRS_MAX_PAGES
+    }
