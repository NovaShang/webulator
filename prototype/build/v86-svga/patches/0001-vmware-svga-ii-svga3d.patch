+        const dv = new DataView(mem.buffer, mem.byteOffset + ppn * 4096, 4096);
+        let next = 0;
+        for(let o = 0; o + 8 <= 4096; o += 8)
+        {
+            const p = dv.getUint32(o, true), n = dv.getUint32(o + 4, true);
+            if(!n) { next = p; break; }
+            for(let i = 0; i < n && pages.length < GMR_MAX_PAGES; i++) pages.push(p + i);
+        }
+        if(!next) break;
+        ppn = next;
+    }
+    this.gmrs.set(id, Uint32Array.from(pages));
