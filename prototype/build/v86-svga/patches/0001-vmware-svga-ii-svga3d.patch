+    io.register_write(HYPERCALL_PORT, this, undefined, undefined, value => this.hypercall(value >>> 0));
+    this.hc_stats = { calls: 0, commands: 0, faults: 0, bytes: 0 };
+    this.hc_log = [];
+
+    this.gpu = new SVGA3D(this);
+    this.init_fifo_registers();
