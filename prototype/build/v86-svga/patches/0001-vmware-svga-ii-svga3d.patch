+    if(!pages) return out;
+    for(let done = 0; done < len;)
+    {
+        const at = offset + done, page = at >>> 12, within = at & 4095, n = Math.min(4096 - within, len - done);
+        if(page >= pages.length) break;
+        const phys = pages[page] * 4096 + within;
+        if(phys + n <= mem.length) out.set(mem.subarray(phys, phys + n), done);
+        done += n;
+    }
+    return out;
+};
+
+/** Write bytes at offset in a GMR (or VRAM). */
+VMwareSVGA.prototype.guest_write = function(gmr, offset, data)
+{
+    if(gmr === GMR_LINEAR) { this.linear_write(offset, data); return; }
+    if(gmr === GMR_FRAMEBUFFER) { this.vga.svga_memory.set(data, offset); return; }
+    const pages = this.gmrs.get(gmr), mem = this.cpu.mem8;
+    if(!pages) return;
+    for(let done = 0; done < data.length;)
+    {
+        const at = offset + done, page = at >>> 12, within = at & 4095, n = Math.min(4096 - within, data.length - done);
+        if(page >= pages.length) break;
+        const phys = pages[page] * 4096 + within;
+        if(phys + n <= mem.length) mem.set(data.subarray(done, done + n), phys);
+        done += n;
+    }
+};
