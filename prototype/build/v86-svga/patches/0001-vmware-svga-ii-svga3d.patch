+    M3x2: 24, CALL: 25, CALLNZ: 26, LOOP: 27, RET: 28, ENDLOOP: 29, LABEL: 30, DCL: 31, POW: 32, CRS: 33, SGN: 34,
+    ABS: 35, NRM: 36, SINCOS: 37, REP: 38, ENDREP: 39, IF: 40, IFC: 41, ELSE: 42, ENDIF: 43, BREAK: 44, BREAKC: 45,
+    MOVA: 46, DEFB: 47, DEFI: 48, TEXCOORD: 64, TEXKILL: 65, TEX: 66, EXPP: 78, LOGP: 79, CND: 80, DEF: 81,
+    CMP: 88, DP2ADD: 90, DSX: 91, DSY: 92, TEXLDD: 93, SETP: 94, TEXLDL: 95, BREAKP: 96,
+    PHASE: 0xFFFD, COMMENT: 0xFFFE, END: 0xFFFF,
+};
