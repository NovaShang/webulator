+};
+
+VMwareSVGA.prototype.hypercall = function(ctrl)
+{
+    this.hc_stats.calls++;
+    const head = new Uint8Array(24);
+    this.hc_fault = -1;
+    if(!this.linear_read(ctrl, 24, head, 0)) return;
+    const hv = new Uint32Array(head.buffer);
+    if(hv[0] !== HC_MAGIC) return;
+    const addr = hv[1], len = hv[2] & ~3;
+    const reply = (status, fault, done) => { hv[3] = status; hv[4] = fault; hv[5] = done; this.linear_write(ctrl, head); };
+    const bytes = new Uint8Array(len);
+    if(!this.linear_read(addr, len, bytes, 0)) { this.hc_stats.faults++; return reply(1, this.hc_fault >>> 0, 0); }
+    const words = new Uint32Array(bytes.buffer);
+    this.hc_stats.bytes += len;
+    let pos = 0;
+    while(pos + 8 <= len)
+    {
+        const id = words[pos >> 2], size = words[(pos >> 2) + 1];
+        if(pos + 8 + size > len) break;
+        const body = words.subarray((pos >> 2) + 2, (pos + 8 + size) >> 2);
+        this.hc_fault = -1;
+        if(id === HC_CMD_LOG)
+        {
+            const text = new TextDecoder().decode(bytes.subarray(pos + 8, pos + 8 + size)).replace(/\0+$/, "");
+            if(this.hc_log.length < 400) this.hc_log.push(text);
+        }
+        else
+        {
+            this.stats3d[id] = (this.stats3d[id] || 0) + 1;
+            this.gpu.command(id, body);         // a view of this call's own copy of the commands
+        }
