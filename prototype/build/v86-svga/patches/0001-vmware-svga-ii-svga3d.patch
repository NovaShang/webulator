+    const body = new Uint32Array(size >> 2);
+    let p = pos + 8;
+    for(let i = 0; i < body.length; i++) { body[i] = f[p >> 2]; p += 4; if(p >= max) p = min; }
+    this.gpu.command(id, body);
+};
