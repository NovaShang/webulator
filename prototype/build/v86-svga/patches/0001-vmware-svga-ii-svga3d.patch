+VMwareSVGA.prototype.update_rect = function(x, y, w, h)
+{
+    // Nothing to do: every guest write to VRAM already marks its page dirty for the next frame.
+};
+
+VMwareSVGA.prototype.get_state = function()
+{
+    return [this.index, this.id, this.enable, this.config_done, this.width, this.height, this.bpp, this.guest_id,
+        this.scratch, this.palette, Array.from(this.gmrs, ([id, pages]) => [id, pages])];
+};
+
+VMwareSVGA.prototype.set_state = function(s)
+{
+    [this.index, this.id, this.enable, this.config_done, this.width, this.height, this.bpp, this.guest_id] = s;
+    this.scratch.set(s[8]);
+    this.palette.set(s[9]);
+    this.gmrs = new Map((s[10] || []).map(([id, pages]) => [id, Uint32Array.from(pages)]));
+    if(this.enable) this.update_mode();
+};
