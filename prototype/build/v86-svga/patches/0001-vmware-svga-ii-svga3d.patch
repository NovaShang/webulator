+        vga.svga_enabled = true;
+        vga.svga_width = this.width;
+        vga.svga_height = this.height;
+        vga.svga_bpp = this.bpp;
+        vga.svga_offset = vga.svga_offset_x = vga.svga_offset_y = 0;
+        vga.graphical_mode = true;
