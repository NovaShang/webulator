+            return;
+        case REG.SYNC:
+            this.process_fifo();
+            return;
+        case REG.GUEST_ID:
+            this.guest_id = value;
+            return;
+        case 41:                                                // GMR_ID
+            this.gmr_id = value;
+            return;
+        case 42:                                                // GMR_DESCRIPTOR: define the GMR from a page list
+            this.define_gmr_from_descriptor(this.gmr_id, value);
