+// VMware SVGA II (PCI 15AD:0405), built on top of the existing VGA device.
+//
+// The legacy VGA ports, the VBE "dispi" ports and the linear framebuffer stay exactly as they are; this adds the
+// SVGA II register file (an index/value pair of 32-bit ports in an I/O BAR) and the command FIFO. VRAM is the first
+// half of the VGA device's memory (BAR1, the existing LFB) and the FIFO lives in the second half (BAR2), so both are
+// plain wasm memory: guest writes cost nothing extra, and the host reads the FIFO directly.
+//
+// Reference: VMware's svga_reg.h (MIT, as shipped in Linux drivers/gpu/drm/vmwgfx/device_include) and QEMU's
+// hw/display/vmware_vga.c.
+
+import { dbg_log } from "./log.js";
+import { LOG_VGA } from "./const.js";
+
+import { SVGA3D } from "./vmware_svga3d.js";
+
+// For Types Only
+import { CPU } from "./cpu.js";
+
+export const SVGA_IO_BASE = 0x1070;
+
+const SVGA_ID_0 = 0x90000000, SVGA_ID_2 = 0x90000002;
+
+const REG = {
+    ID: 0, ENABLE: 1, WIDTH: 2, HEIGHT: 3, MAX_WIDTH: 4, MAX_HEIGHT: 5, DEPTH: 6, BITS_PER_PIXEL: 7,
+    PSEUDOCOLOR: 8, RED_MASK: 9, GREEN_MASK: 10, BLUE_MASK: 11, BYTES_PER_LINE: 12, FB_START: 13, FB_OFFSET: 14,
+    VRAM_SIZE: 15, FB_SIZE: 16, CAPABILITIES: 17, MEM_START: 18, MEM_SIZE: 19, CONFIG_DONE: 20, SYNC: 21, BUSY: 22,
+    GUEST_ID: 23, CURSOR_ID: 24, CURSOR_X: 25, CURSOR_Y: 26, CURSOR_ON: 27, HOST_BITS_PER_PIXEL: 28,
+    SCRATCH_SIZE: 29, MEM_REGS: 30, NUM_DISPLAYS: 31, PITCHLOCK: 32, IRQMASK: 33, NUM_GUEST_DISPLAYS: 34,
+    TOP: 48,
+};
+const SCRATCH_BASE = 0x40, SCRATCH_SIZE = 64, PALETTE_BASE = 0x400;
+
+export const SVGA_CAP = {
+    RECT_COPY: 1 << 1, CURSOR: 1 << 5, EIGHT_BIT_EMULATION: 1 << 8, CURSOR_BYPASS: 1 << 6, CURSOR_BYPASS_2: 1 << 7, ALPHA_CURSOR: 1 << 9,
+    THREE_D: 1 << 14, EXTENDED_FIFO: 1 << 15, MULTIMON: 1 << 16, PITCHLOCK: 1 << 17, IRQMASK: 1 << 18,
+    DISPLAY_TOPOLOGY: 1 << 19, GMR: 1 << 20, TRACES: 1 << 21, GMR2: 1 << 22, SCREEN_OBJECT_2: 1 << 23,
+};
+
+// FIFO registers, in dwords.
+export const FIFO = {
+    MIN: 0, MAX: 1, NEXT_CMD: 2, STOP: 3, CAPABILITIES: 4, FLAGS: 5, FENCE: 6, HWVERSION_3D: 7, PITCHLOCK: 8,
+    CURSOR_ON: 9, CURSOR_X: 10, CURSOR_Y: 11, CURSOR_COUNT: 12, CURSOR_LAST_UPDATED: 13, RESERVED: 14,
+    CURSOR_SCREEN_ID: 15, DEAD: 16, HWVERSION_3D_REVISED: 17, CAPS_3D: 32, CAPS_3D_LAST: 32 + 255,
+    GUEST_HWVERSION_3D: 288, FENCE_GOAL: 289, BUSY: 290, NUM_REGS: 291,
+};
+export const FIFO_CAP = { FENCE: 1 << 0, ACCELFRONT: 1 << 1, PITCHLOCK: 1 << 2, CURSOR_BYPASS_3: 1 << 4, RESERVE: 1 << 6, GMR2: 1 << 8 };
+
+const CMD = {
+    UPDATE: 1, RECT_FILL: 2, RECT_COPY: 3, DEFINE_CURSOR: 19, DEFINE_ALPHA_CURSOR: 22, UPDATE_VERBOSE: 25,
+    FRONT_ROP_FILL: 29, FENCE: 30, ESCAPE: 33, DEFINE_SCREEN: 34, DESTROY_SCREEN: 35, DEFINE_GMRFB: 36,
+    BLIT_GMRFB_TO_SCREEN: 37, BLIT_SCREEN_TO_GMRFB: 38, ANNOTATION_FILL: 39, ANNOTATION_COPY: 40,
+    DEFINE_GMR2: 41, REMAP_GMR2: 42,
+};
+// Fixed body sizes (dwords after the command id) of the 2D commands without a size field.
+const CMD_WORDS = { 1: 4, 2: 5, 3: 6, 25: 5, 29: 6, 30: 1, 35: 1, 36: 4, 37: 7, 38: 7, 39: 1, 40: 3, 41: 2 };
+const CMD_3D_FIRST = 1040, CMD_3D_LAST = 1999;
+
+const MAX_WIDTH = 1600, MAX_HEIGHT = 1200;
+const GMR_MAX_IDS = 64, GMR_MAX_PAGES = 65536;
+const GMR_FRAMEBUFFER = 0xFFFFFFFE;
+/** Pseudo-GMR of the API-forwarding path: the offset is a linear address in the calling guest process. */
+const GMR_LINEAR = 0xFFFFFFFD;
+const HYPERCALL_PORT = 0x5680;
+const HC_MAGIC = 0x44334657;            // "WF3D"
+const HC_CMD_LOG = 0x7F000001;
+
+// ---------- 3D (legacy SVGA3D) ----------
+const HWVERSION_3D = 2 << 16 | 1;                     // SVGA3D_HWVERSION_WS8_B1
+const CAPS_RECORD_DEVCAPS = 0x100;
+// SVGA3dVertexShaderVersion / SVGA3dPixelShaderVersion: NONE 0, VS 1.1/2.0/3.0 = 3/5/7, PS 1.1/1.4/2.0/3.0 = 3/9/11/13.
+const VS_VERSION = 7, PS_VERSION = 13;
+const F = new Float32Array(1), U = new Uint32Array(F.buffer);
+const float_bits = x => { F[0] = x; return U[0]; };
+const FMT = {
+    TEXTURE: 0x1, CUBETEXTURE: 0x4, OFFSCREEN_RENDERTARGET: 0x8, SAME_FORMAT_RENDERTARGET: 0x10, ZSTENCIL: 0x40,
+    ZSTENCIL_ANY_COLOR: 0x80, SAME_FORMAT_UP_TO_ALPHA_RT: 0x100, DISPLAYMODE: 0x400, ACCEL_3D: 0x800,
+    CONVERT_TO_ARGB: 0x2000, OFFSCREENPLAIN: 0x4000, MEMBEROFGROUP_ARGB: 0x80000,
+};
+const COLOR_FMT = FMT.TEXTURE | FMT.CUBETEXTURE | FMT.OFFSCREEN_RENDERTARGET | FMT.SAME_FORMAT_RENDERTARGET |
+    FMT.ACCEL_3D | FMT.CONVERT_TO_ARGB | FMT.OFFSCREENPLAIN | FMT.MEMBEROFGROUP_ARGB;
+const TEX_FMT = FMT.TEXTURE | FMT.CUBETEXTURE | FMT.OFFSCREENPLAIN;
+const DEPTH_FMT = FMT.ZSTENCIL | FMT.ZSTENCIL_ANY_COLOR;
+// SVGA3D_DEVCAP_* index → value: a D3D9-class device (SM 3.0, 8 lights, 6 clip planes, DXT, D16/D24S8).
+const DEVCAPS = [
+    [0, 1], [1, 8], [2, 8], [3, 6], [4, VS_VERSION], [5, VS_VERSION ? 1 : 0], [6, PS_VERSION], [7, PS_VERSION ? 1 : 0], [8, 4], [9, 0], [10, 0], [11, 4],
+    [12, 1], [13, 1], [14, 1], [15, 1], [16, 1], [17, float_bits(64)], [18, 16], [19, 4096], [20, 4096],
+    [21, 256], [22, 8192], [23, 4096], [24, 16], [25, 0xFFFFF], [26, 0xFFFFF], [27, 512], [28, 512],
+    [29, 32], [30, 32], [31, (1 << 26) - 1],
+    [32, COLOR_FMT | FMT.DISPLAYMODE], [33, COLOR_FMT | FMT.SAME_FORMAT_UP_TO_ALPHA_RT], [35, COLOR_FMT],
+    [36, COLOR_FMT], [37, COLOR_FMT], [38, COLOR_FMT | FMT.DISPLAYMODE], [39, TEX_FMT], [40, TEX_FMT],
+    [41, TEX_FMT], [42, TEX_FMT], [43, DEPTH_FMT], [44, DEPTH_FMT], [45, DEPTH_FMT],
+    [46, TEX_FMT], [47, TEX_FMT], [48, TEX_FMT], [49, TEX_FMT], [50, TEX_FMT],
+    [63, 4], [64, 4], [77, 256], [78, 32768],
+];
+
+/**
+ * @constructor
+ * @param {CPU} cpu
+ * @param {Object} vga the VGAScreen this extends
+ * @param {number} lfb_address physical address of VRAM (BAR1)
+ */
+export function VMwareSVGA(cpu, vga, lfb_address)
+{
+    this.cpu = cpu;
+    this.vga = vga;
+    this.vram_size = vga.vga_memory_size / 2;
+    this.fifo_offset = this.vram_size;                 // byte offset of the FIFO within the VGA memory
+    this.fifo_size = Math.min(this.vram_size, 2 * 1024 * 1024);
+    this.lfb_address = lfb_address;
+    this.fifo_address = lfb_address + this.fifo_offset;
+
+    this.index = 0;
+    this.id = SVGA_ID_2;
+    this.enable = 0;
+    this.config_done = 0;
+    this.width = 1024;
+    this.height = 768;
+    this.bpp = 32;
+    this.guest_id = 0;
+    this.scratch = new Int32Array(SCRATCH_SIZE);
+    this.palette = new Uint8Array(256 * 3);
+
+    // Hooks for the 3D layer (and a command log while we learn what the XP driver sends).
+    this.capabilities = SVGA_CAP.EXTENDED_FIFO | SVGA_CAP.THREE_D | SVGA_CAP.EIGHT_BIT_EMULATION | SVGA_CAP.GMR | SVGA_CAP.GMR2;
+    this.fifo_capabilities = FIFO_CAP.FENCE | FIFO_CAP.RESERVE | FIFO_CAP.GMR2;
+    /** Guest memory regions: id → guest physical page numbers. */
+    this.gmrs = new Map();
+    this.gmr_id = 0;
+    this.hw_version_3d = HWVERSION_3D;
+    /** 3D command log: counts per id, and the first commands in order (while we learn the driver). */
+    this.stats3d = Object.create(null);
+    this.trace3d = [];
+    /** @type {function(number, Uint32Array, number, number)|null} */
+    this.on_3d_command = null;
+    this.stats = Object.create(null);
+    this.reg_log = [];
+
+    const io = cpu.io;
+    const base = SVGA_IO_BASE;
+    io.register_read(base, this, undefined, undefined, () => this.index);
+    io.register_write(base, this, undefined, undefined, value => { this.index = value >>> 0; });
+    io.register_read(base + 1, this, undefined, undefined, () => this.read_reg(this.index));
+    io.register_write(base + 1, this, undefined, undefined, value => this.write_reg(this.index, value >>> 0));
+    io.register_read(base + 2, this, () => 0, () => 0, () => 0);              // BIOS port
+    io.register_read(base + 8, this, () => 0, () => 0, () => 0);              // IRQ status
+    io.register_write(base + 8, this, undefined, undefined, () => {});
